# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/localfix

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Dedicated admin authentication (server-only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google Identity Services OAuth Web Client
GOOGLE_CLIENT_ID=

# Twilio SMS delivery for OTP sign-in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio SMS-capable sender number in E.164 format, e.g. +14155552671
TWILIO_PHONE_NUMBER=


SMTP_HOST=your SMTP host
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=Your SMTP username
SMTP_PASS=Your SMTP password
SMTP_FROM=your_sender_email